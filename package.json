{
  "name": "@eddieparc/senpi-accounts",
  "version": "0.1.0",
  "description": "Senpi addon: multi-account subscription providers (Kiro) with cache-preserving routing, usage-aware placement and 429 failover.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "senpi",
    "senpi-extension",
    "kiro",
    "multi-account",
    "provider-accounts"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "[ -f tsconfig.build.json ] && npm run build || exit 0",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": ">=2026.7.28"
  },
  "devDependencies": {
    "@code-yeongyu/senpi": "^2026.7.29",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
